# Server-side only: never copy into the APK.
OPENAI_API_KEY=replace-with-your-server-side-provider-key
OPENAI_ASR_MODEL=gpt-transcribe
OPENAI_TEXT_MODEL=gpt-4.1-mini
# Use a strong random different value for each:
NOTEFLOW_PAIRING_SECRET=replace-with-a-private-pairing-secret
NOTEFLOW_SIGNING_KEY=replace-with-a-long-random-hmac-key
NOTEFLOW_CACHE_DB=noteflow-cache.sqlite3
OPENAI_BASE_URL=https://api.openai.com/v1

# Phase-2 capabilities. Empty disables diarization with an explicit HTTP 503.
# The example OpenAI model below is deprecated and ends 2027-02-26; replace it.
NOTEFLOW_DIARIZATION_MODEL=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Phase 3 multi-tenant enterprise portal (server-side only)
NOTEFLOW_ENTERPRISE_DB=noteflow-enterprise.sqlite3
NOTEFLOW_ENTERPRISE_BOOTSTRAP_SECRET=replace-with-a-random-32-character-secret
NOTEFLOW_ENTERPRISE_SIGNING_KEY=replace-with-different-random-32-character-secret
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
NOTEFLOW_ENTERPRISE_FERNET_KEY=replace-with-a-generated-fernet-key
NOTEFLOW_PUBLIC_ORIGIN=https://your-server.example.com
MS_TENANT_ID=organizations
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_SCOPES=offline_access User.Read OnlineMeetingTranscript.Read.All
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_SCOPES=cloud_recording:read:list_user_recordings
