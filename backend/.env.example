# Server-side only: never copy into the APK.
OPENAI_API_KEY=replace-with-your-server-side-provider-key
OPENAI_ASR_MODEL=gpt-transcribe
OPENAI_TEXT_MODEL=gpt-4.1-mini
# Use a strong random different value for each:
NOTEFLOW_PAIRING_SECRET=replace-with-a-private-pairing-secret
NOTEFLOW_SIGNING_KEY=replace-with-a-long-random-hmac-key
NOTEFLOW_CACHE_DB=noteflow-cache.sqlite3
OPENAI_BASE_URL=https://api.openai.com/v1
